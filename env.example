# Database
MONGODB_URI=mongodb://localhost:27017/user-api
MONGODB_HOST=localhost:27017
DB_NAME=user-api

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Internal API Key (for microservice communication)
# IMPORTANT: This must match the INTERNAL_API_KEY in all other microservices (academic-api, etc.)
INTERNAL_API_KEY=your-internal-api-key

# Base URL for notifications API (optional)
# If not set, defaults to http://localhost:3005
# For production: https://cognify-dev.blackhives.com
BASE_URL=http://localhost:3005

# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

