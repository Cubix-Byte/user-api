{
  "name": "user-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "local": "ts-node -r tsconfig-paths/register src/server.ts",
    "debug": "node --inspect-brk=9229 -r ts-node/register -r tsconfig-paths/register src/server.ts",
    "debug:simple": "node debug-server.js",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:reset": "ts-node -r tsconfig-paths/register src/utils/seeders/resetDatabase.ts",
    "update-passwords": "ts-node -r tsconfig-paths/register src/utils/update-passwords.ts",
    "cleanup:duplicate-users": "ts-node -r tsconfig-paths/register src/utils/remove-duplicate-users.ts",
    "unlock-user": "ts-node -r tsconfig-paths/register src/utils/unlock-user.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "keywords": [
    "nodejs",
    "mongodb",
    "express",
    "typescript",
    "user",
    "auth",
    "microservice"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "User Authentication Microservice with MongoDB",
  "dependencies": {
    "shared-lib": "1.0.32",
    "@types/nodemailer": "^7.0.4",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.10",
    "tsc-alias": "^1.8.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "24.3.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
